# Copia este archivo como .env y ajusta los valores.

# ─── API ─────────────────────────────────────────────────────
# Android emulator → 10.0.2.2  |  iOS simulator → 127.0.0.1
# Dispositivo físico → IP local de tu máquina (ej. 192.168.1.X)
# IA local = 8082 (login + datos del embajador) · IAM = 8080
AUTH_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8082

# ─── Feature flags ───────────────────────────────────────────
ENABLE_MOCK_FALLBACK=false
